# Copy to .env for local development. Never commit a real .env.
SKYLOCK_ENV=local

# --- datastores -------------------------------------------------------------
# Host-side URLs (running the app outside compose). Inside compose the service
# names are used instead; see docker-compose.yml.
DATABASE_URL=postgresql+asyncpg://skylock_app:skylock_app@localhost:5432/skylock
REDIS_URL=redis://localhost:6379/0

# --- auth -------------------------------------------------------------------
# 32+ random bytes, base64. Generate: openssl rand -base64 48
JWT_SECRET=dev-only-insecure-secret-change-me-0000000000000000
ACCESS_TOKEN_TTL_SECONDS=600
REFRESH_TOKEN_TTL_SECONDS=1209600
LOGIN_MAX_FAILURES=5
LOGIN_LOCKOUT_SECONDS=900

# --- seat holds -------------------------------------------------------------
HOLD_TTL_SECONDS=600
HOLD_SWEEP_INTERVAL_SECONDS=30
MAX_ACTIVE_HOLDS_PER_USER=6

# --- dashboard (HTTP Basic, read-only views) --------------------------------
DASHBOARD_ENABLED=true
DASHBOARD_USER=dash
DASHBOARD_PASSWORD=dash-dev-password

# --- rate limiting ----------------------------------------------------------
RATE_LIMIT_ENABLED=true

# --- payments ---------------------------------------------------------------
# fake = deterministic in-process gateway driven by card-token suffixes.
PAYMENT_PROVIDER=fake
